  "query": "SELECT m.id,\n                    m.entry_id AS item_id,\n                    m.media_type AS \"media_type: MediaType\",\n                    m.local_path AS \"path!: String\",\n                    m.file_size,\n                    m.duration\n             FROM entry_media m\n             WHERE m.local_path IS NOT NULL\n               AND EXISTS (\n                   SELECT 1 FROM collection_entries ce\n                   WHERE ce.entry_id = m.entry_id AND ce.collection_id = ?\n               )",
